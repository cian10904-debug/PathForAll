{
  "name": "pathforall",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-aware NYC pedestrian routing and local scheduled transit service",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "test": "npm run test:unit",
    "test:unit": "node scripts/test-all.js",
    "test:e2e": "playwright test",
    "lint:js": "eslint .",
    "lint:css": "stylelint styles.css",
    "lint:html": "html-validate index.html",
    "format:check": "prettier --check package.json vite.config.js eslint.config.js playwright.config.js jsconfig.json storage-adapter.js fetch-client.js app-version.js accessibility.js domain.d.ts route-session.js needs.js weather-service.js map-integration.js ui-dom.js \"scripts/*.js\" \"server/*.js\" agency-time.js route-timeline.js transit-modes.js",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "package": "node scripts/package.js",
    "syntax": "node scripts/check-syntax.js",
    "verify": "node scripts/verify.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "evaluate:live": "node scripts/evaluate-live.js",
    "verify:otp-schema": "node scripts/verify-otp-schema.js"
  },
  "dependencies": {
    "maplibre-gl": "6.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "graphql": "16.15.0",
    "html-validate": "11.22.1",
    "prettier": "3.9.6",
    "stylelint": "16.26.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
