{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "off",
    "doctype-style": "off",
    "element-required-attributes": "error",
    "input-missing-label": "error",
    "long-title": "off",
    "no-inline-style": "error",
    "no-raw-characters": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "void-style": "off",
    "wcag/h30": "off"
  }
}
