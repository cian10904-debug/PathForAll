# Node backend and production static site. Local by default.
HOST=127.0.0.1
PORT=8787
# Same-origin hosting requires no CORS configuration. Add exact origins only if split.
ALLOWED_ORIGINS=
PFA_CONCURRENCY=4
PFA_REQUESTS_PER_MINUTE=120
# PFA_DIST=dist

# Leave OTP_URL empty for pedestrian-only startup. Uncomment after graph build:
# OTP_URL=http://127.0.0.1:8080/otp/gtfs/v1
# TRANSIT_MANIFEST=otp-data/manifest.json
OTP_TIMEOUT_MS=11000
# Optional independent OTP provider with its own verified inputs:
# OTP_FALLBACK_URL=https://routing.example.org/otp/gtfs/v1
# TRANSIT_FALLBACK_MANIFEST=otp-fallback/manifest.json

# For Vite development with the Node backend, uncomment both:
# VITE_ACCESSIBLE_ROUTING_URL=/api/routes
# VITE_ACCESSIBLE_ROUTING_CAPABILITIES_URL=/api/capabilities
# Production builds default to the same-origin endpoints above.
# Optional external adapters must be application-owned and credential-free URLs.
# VITE_TRANSIT_NETWORK_URL=
# VITE_TRANSIT_ARRIVALS_URL=
# VITE_ACCESSIBLE_ROUTING_MODES=walk

# Optional operator-provided URLs (no credentials in frontend configuration):
# VITE_GEOCODE_FORWARD_URL=https://search.example.org/api/
# VITE_GEOCODE_REVERSE_URL=https://search.example.org/reverse
# VITE_GEOCODE_FALLBACK_URL=https://fallback.example.org/search
# VITE_MAP_RASTER_TILES=https://tiles.example.org/{z}/{x}/{y}.png
