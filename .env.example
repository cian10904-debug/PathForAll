# Optional URLs for application-owned, server-side integrations.
# Do not put provider API keys in this browser application.
# Use HTTPS URLs without embedded credentials, fragments, or secret query parameters.
VITE_ACCESSIBLE_ROUTING_URL=
# Safe default is "walk". List only modes the configured provider actually supports.
VITE_ACCESSIBLE_ROUTING_MODES=walk
# Optional application-owned endpoint returning current, timestamped capabilities.
# Use elevatorAccessibilityPaths only when complete entrance-to-platform paths are verified.
VITE_ACCESSIBLE_ROUTING_CAPABILITIES_URL=
VITE_TRANSIT_NETWORK_URL=
VITE_TRANSIT_ARRIVALS_URL=
