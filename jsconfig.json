{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["vite/client", "node"]
  },
  "include": [
    "*.js",
    "*.d.ts",
    "server/**/*.js",
    "scripts/**/*.js",
    "evaluation/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "test-*.js"]
}
